# Configuración de Cluster-AI (IALP)
# Proveedor de Inteligencia Artificial (Protocolo compatible con OpenAI)
OPENAI_API_KEY=sk-tu-api-key-aqui
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Modo de ejecución: 'cluster' (usa Slurm del sistema) o 'mock' (usa Slurm-Mockup local)
CLUSTER_AI_MODE=cluster

# Ruta de base de datos de trazabilidad (producción y mock)
CLUSTER_AI_DB_PATH=cluster.db
CLUSTER_AI_MOCK_DB_PATH=cluster_mock.db

# Fase actual: solo se optimiza el script #SBATCH. Poner en 'true' solo en desarrollo
# local para probar la auditoría del código fuente del proyecto (no disponible en el servidor).
CLUSTER_AI_ENABLE_CODE_AUDIT=false

# Verificación TLS hacia el proveedor de IA (no desactivar salvo endpoints locales de prueba)
OPENAI_TLS_VERIFY=true
