# Configuración de Cluster-AI (IALP)
# Credenciales para Agnes AI Platform (OpenAI compatible)
AGNES_API_KEY=tu_api_key_aqui
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash

# Modo de ejecución: 'cluster' (usa Slurm del sistema) o 'mock' (usa Slurm-Mockup local)
CLUSTER_AI_MODE=cluster

# Ruta de base de datos de trazabilidad (producción y mock)
CLUSTER_AI_DB_PATH=cluster.db
CLUSTER_AI_MOCK_DB_PATH=cluster_mock.db
